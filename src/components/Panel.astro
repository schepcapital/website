---
interface Props {
  title?: string;
  step?: number;
  class?: string;
  contentClass?: string;
  interactiveSpotlight?: boolean;
}

const {
  title,
  step,
  class: className,
  contentClass = 'px-4 pb-4 sm:px-5 sm:pb-5',
  interactiveSpotlight = false,
} = Astro.props;
---

<section
  data-spotlight={interactiveSpotlight || undefined}
  class:list={[
    'glass',
    { 'spotlight-interactive': interactiveSpotlight },
    className,
  ]}
>
  {interactiveSpotlight && <span class="spotlight-edge" aria-hidden="true"></span>}
  <div class="relative z-2">
    {title && (
      <header class="px-4 pt-4 pb-2 sm:px-5 sm:pt-5">
        <h2 class:list={[
          'text-xl text-balance font-semibold tracking-[-0.011em] text-ink',
          { 'flex items-baseline gap-2.5': step !== undefined },
        ]}>
          {step !== undefined && (
            <span class="inline-grid size-6 shrink-0 place-items-center rounded-full bg-accent-surface font-mono text-xs text-accent-text">
              {step}
            </span>
          )}
          <span>{title}</span>
        </h2>
      </header>
    )}
    <div class={contentClass}>
      <slot />
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    for (const panel of document.querySelectorAll<HTMLElement>('[data-spotlight]')) {
      const setSpotlightPosition = (event: PointerEvent) => {
        const bounds = panel.getBoundingClientRect();
        panel.style.setProperty('--spot-x', `${event.clientX - bounds.left}px`);
        panel.style.setProperty('--spot-y', `${event.clientY - bounds.top}px`);
      };

      panel.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        setSpotlightPosition(event);
        panel.setAttribute('data-spot-hover', '');
      }, { passive: true });

      panel.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        setSpotlightPosition(event);
        panel.setAttribute('data-spot-hover', '');
      });
      panel.addEventListener('pointerleave', () => {
        panel.removeAttribute('data-spot-hover');
      });
    }
  });
</script>
