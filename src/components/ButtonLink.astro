---
interface Props {
  href: string;
  newTab?: boolean;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, newTab = false, variant = 'secondary', class: className } = Astro.props;
const variants = {
  primary:
    'text-on-accent bg-linear-to-b from-accent to-accent-hover ' +
    'shadow-[inset_0_1px_0_0_rgb(255_255_255/0.24),0_1px_2px_-1px_rgb(0_0_0/0.4),0_4px_16px_-6px_var(--sem-accent-glow)] ' +
    'hover:shadow-[inset_0_1px_0_0_rgb(255_255_255/0.28),0_1px_2px_-1px_rgb(0_0_0/0.4),0_8px_24px_-6px_var(--sem-accent)] ' +
    'active:shadow-[inset_0_1px_3px_0_rgb(0_0_0/0.28)]',
  secondary:
    'text-ink bg-glass-raised backdrop-blur-md shadow-[var(--elevation-control)] ' +
    'hover:bg-[var(--sem-accent-surface)] hover:text-accent-text ' +
    'active:shadow-[inset_0_1px_3px_0_rgb(0_0_0/0.2)]',
};
---

<a
  {href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
  class:list={[
    'relative inline-flex min-h-11 w-full select-none items-center justify-center gap-1.5 text-center sm:w-auto rounded-[var(--radius-control)] px-4 py-2 text-base font-medium transition-[background-color,box-shadow,transform,color,filter] duration-[var(--dur-instant)] ease-[var(--ease-out)] active:translate-y-[0.5px]',
    variants[variant],
    className,
  ]}
>
  <slot />
  {newTab && <span class="sr-only"> (opens in a new tab)</span>}
</a>
